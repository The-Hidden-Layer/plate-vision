# Copy to .env before `docker compose up`:  cp .env.example .env

# --- Postgres ---
POSTGRES_DB=platevision
POSTGRES_USER=platevision
POSTGRES_PASSWORD=platevision
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Dev-only default. Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Celery / Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI service ---
# Inside the compose network. To run the model natively on the host instead
# (e.g. for GPU access on Apple Silicon), use:
#   AI_SERVICE_URL=http://host.docker.internal:8100
AI_SERVICE_URL=http://ai-service:8100
# Native Mac deployment can persist the host-service/shared-media override:
# COMPOSE_FILE=docker-compose.yml:docker-compose.mps.yml
AI_REQUEST_TIMEOUT_SECONDS=600
# Base delay before retrying a transient AI failure; doubles each attempt (5s, 10s).
AI_RETRY_BACKOFF_SECONDS=5

# --- Media ---
# Mount point of the shared `media` docker volume, identical in
# backend, worker and ai-service.
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=200

# --- AI pipeline ---
# Which implementation each stage uses: 'stub' or 'model'.
# 'model' = apps/ai-service/app/lpd/model.py and app/lpr/model.py.
LPD_BACKEND=stub
LPR_BACKEND=stub
# Paths inside the container; apps/ai-service is mounted at /app.
# LPD_WEIGHTS=/app/weights/lpd/best.pt
# LPR_WEIGHTS=/app/weights/lpr/best.pt
# Analyze across the full video timeline. MAX_FRAMES/STUB_MAX_FRAMES are retired.
VIDEO_SAMPLE_FPS=2
# Fake latency so the polling UI is visible. Stub backends only.
STUB_DELAY_MS=0

# --- Frontend ---
# Server-side origin used by the Next.js rewrites proxy.
BACKEND_ORIGIN=http://backend:8000

# --- Real model runtime (native macOS for MPS; NVIDIA profile for CUDA) ---
AI_DEVICE=auto
AI_PRECISION=fp32
LPD_IMAGE_SIZE=1280
LPD_CONFIDENCE=0.25
LPD_IOU=0.7
MAX_DETECTIONS=100
LPR_MIN_CONFIDENCE=0
LPR_BATCH_SIZE=32
# Classical enhancement is opt-in until full validation and latency gates pass.
# none, bicubic, lanczos, small_bicubic, unsharp, clahe, bilateral, bicubic_unsharp
LPR_ENHANCEMENT=none
INFERENCE_QUEUE_SIZE=2
IMAGE_MAX_UPLOAD_MB=10
IMAGE_MAX_PIXELS=20000000
