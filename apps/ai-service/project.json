{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ai-service",
  "projectType": "application",
  "sourceRoot": "apps/ai-service",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose up ai-service"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose run --rm --no-deps ai-service pytest"
      },
      "inputs": ["python"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose run --rm --no-deps ai-service ruff check ."
      },
      "inputs": ["python"],
      "cache": true
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose run --rm --no-deps -T ai-service python -c \"import json; from app.main import app; print(json.dumps(app.openapi(), indent=2))\" > libs/api-types/ai-openapi.json"
      },
      "outputs": ["{workspaceRoot}/libs/api-types/ai-openapi.json"],
      "cache": false
    }
  }
}
